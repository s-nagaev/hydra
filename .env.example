# Address for the HTTP listener (default: 127.0.0.1:8080). Under Docker bind
# 0.0.0.0:8080 instead so the published port reaches the app; the Dockerfile
# and docker-compose.yml set that for you.
HYDRA_BIND_ADDR=127.0.0.1:8080

# Path to the SQLite database file, created on first run (default: ./hydra.db).
HYDRA_DB_PATH=./hydra.db

# Single admin user for the /admin routes (HTTP Basic Auth). Both variables
# are required at startup; empty values abort with a named error.
HYDRA_ADMIN_LOGIN=admin
HYDRA_ADMIN_PASSWORD=change-me

# Store request/response bodies in request_logs, capped at 1 MB per side.
# Adds storage and I/O; keep false unless debugging.
HYDRA_LOG_BODIES=false
