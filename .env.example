# Hydra reads configuration from environment variables. For local runs the
# binary also loads a .env file from the working directory if present (copy
# this file to .env and edit it); variables already set in the environment
# always win over the file.

# Address for the HTTP listener (default: 127.0.0.1:8080). Under Docker bind
# 0.0.0.0:8080 instead so the published port reaches the app; the Dockerfile
# and docker-compose.yml set that for you.
HYDRA_BIND_ADDR=127.0.0.1:8080

# Database target. When set, the scheme picks the backend: `sqlite:<path>`
# selects SQLite, `postgres://user:password@host:5432/dbname` selects
# PostgreSQL. Any other scheme aborts startup. The URL carries credentials,
# so Hydra never logs it (masked as postgres://<redacted> everywhere).
# When this variable is unset, HYDRA_DB_PATH below keeps SQLite the default.
#HYDRA_DATABASE_URL=sqlite:./hydra.db

# Path to the SQLite database file, created on first run (default: ./hydra.db).
# Only used when HYDRA_DATABASE_URL is not set.
HYDRA_DB_PATH=./hydra.db

# Single admin user for the /admin routes (HTTP Basic Auth). Both variables
# are required at startup; empty values abort with a named error.
HYDRA_ADMIN_LOGIN=admin
HYDRA_ADMIN_PASSWORD=change-me

# Store request/response bodies in request_logs, capped at 1 MB per side.
# Adds storage and I/O; keep false unless debugging.
HYDRA_LOG_BODIES=false

# Lifetime of the in-memory key→channel resolution cache, in seconds
# (default: 3600). Within the TTL a proxy call is served without touching
# the database. Admin mutations invalidate immediately, so disabling keys or
# channels and rotating upstream credentials through the admin API take
# effect at once; the TTL only bounds drift from out-of-band database edits.
# 0 disables the cache entirely.
HYDRA_CACHE_TTL_SECS=3600

# Comma-separated IPv4/IPv6 CIDR networks of reverse proxies Hydra runs
# behind (Caddy, Nginx, ...). When a request's direct peer address falls
# inside one of these networks, the logged client IP is taken from the
# X-Forwarded-For header (the first entry outside the trusted set); a bare
# address means that single host. Leave empty (default) when clients reach
# Hydra directly: every request is then attributed to its direct peer
# address, and a client-sent X-Forwarded-For header is ignored entirely.
# Invalid entries abort startup.
#HYDRA_TRUSTED_PROXIES=127.0.0.1/32, 10.0.0.0/8, fd00::/8

