# Hydra reads configuration from environment variables. For local runs the
# binary also loads a .env file from the working directory if present (copy
# this file to .env and edit it); variables already set in the environment
# always win over the file.

# Address for the HTTP listener (default: 127.0.0.1:8080). Under Docker bind
# 0.0.0.0:8080 instead so the published port reaches the app; the Dockerfile
# and docker-compose.yml set that for you.
HYDRA_BIND_ADDR=127.0.0.1:8080

# Database target. When set, the scheme picks the backend: `sqlite:<path>`
# selects SQLite, `postgres://user:password@host:5432/dbname` selects
# PostgreSQL. Any other scheme aborts startup. The URL carries credentials,
# so Hydra never logs it (masked as postgres://<redacted> everywhere).
# When this variable is unset, HYDRA_DB_PATH below keeps SQLite the default.
#HYDRA_DATABASE_URL=sqlite:./hydra.db

# Path to the SQLite database file, created on first run (default: ./hydra.db).
# Only used when HYDRA_DATABASE_URL is not set.
HYDRA_DB_PATH=./hydra.db

# Single admin user for the /admin routes: HTTP Basic Auth on every admin
# route, and the credentials of the admin UI login form, whose session
# cookies are signed with a key derived from this password. Both variables
# are required at startup; empty values abort with a named error.
HYDRA_ADMIN_LOGIN=admin
HYDRA_ADMIN_PASSWORD=change-me

# Optional signing key for the admin UI session cookies. Unset (the default),
# the key is derived from HYDRA_ADMIN_PASSWORD, so changing the password ends
# every session. Set it to keep sessions valid across a password rotation;
# treat it as a password. An empty value counts as unset.
#HYDRA_SESSION_SECRET=

# Store request/response bodies in request_logs, capped at 1 MB per side.
# Adds storage and I/O; keep false unless debugging.
HYDRA_LOG_BODIES=false

# Lifetime of the in-memory key→channel resolution cache, in seconds
# (default: 3600). Within the TTL a proxy call is served without touching
# the database. Admin mutations invalidate immediately, so disabling keys or
# channels and rotating upstream credentials through the admin API take
# effect at once; the TTL only bounds drift from out-of-band database edits.
# 0 disables the cache entirely.
HYDRA_CACHE_TTL_SECS=3600

# Comma-separated IPv4/IPv6 CIDR networks of reverse proxies Hydra runs
# behind (Caddy, Nginx, ...). When a request's direct peer address falls
# inside one of these networks, the logged client IP is taken from the
# X-Forwarded-For header (the first entry outside the trusted set); a bare
# address means that single host, and spaces around the commas are ignored.
# Empty value or unset (the default) when clients reach Hydra directly: every
# request is then attributed to its direct peer address, and a client-sent
# X-Forwarded-For header is ignored entirely.
# List the proxy's own address: 127.0.0.1/32 for a proxy on the same host, the
# proxy's address on the compose network (e.g. an overlay subnet such as
# 10.0.4.0/24) for a proxy container. Trust only proxies you control: a caller
# connecting from a trusted address can forge the logged client IP.
# Invalid entries abort startup.
HYDRA_TRUSTED_PROXIES=127.0.0.1/32


# Anonymous-401 flood cap. After HYDRA_FLOOD_LIMIT failed key
# authentications (missing, malformed or unknown key) from the same client
# IP within HYDRA_FLOOD_WINDOW_SECS, further requests from that IP are
# answered with the same 401 an unknown key gets, but the key lookup never
# runs, and at most one request_logs row per window per IP is written for
# the capped phase. Admission is atomic, so a parallel burst cannot exceed
# the limit either. The counter only resets when the window expires.
# Once the limit is reached, every request from that IP is rejected for the
# rest of the window, requests carrying a valid API key included (legitimate
# traffic behind the same NAT or proxy address is locked out too), and the
# body says "Invalid API key provided" regardless. 0 disables the cap.
HYDRA_FLOOD_LIMIT=60
HYDRA_FLOOD_WINDOW_SECS=60

# Note on auth rejection ordering: the chat body is buffered (up to the
# 32 MiB body limit) before a missing or bad key is answered, so an
# unauthenticated request always pays the body buffering, and a request
# whose body exceeds 32 MiB is rejected with 413 even when its key is also
# invalid (the body limit runs before the auth response).
